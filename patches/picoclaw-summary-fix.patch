+// summaryDigest turns a history message into what the summariser should see.
+// user/assistant text is kept as is; assistant tool calls and tool results are
+// reduced to short one-line digests (they used to be dropped completely, which
+// made the agent forget what it had already done). Other roles are skipped.
+func summaryDigest(msg providers.Message) (providers.Message, bool) {
+	const (
+		maxToolArgRunes    = 150
+		maxToolResultRunes = 300
+	)
+	clip := func(text string, limit int) string {
+		runes := []rune(strings.TrimSpace(text))
+		if len(runes) <= limit {
+			return string(runes)
+		}
+		return string(runes[:limit]) + "..."
+	}
+
+	switch msg.Role {
+	case "user":
+		return msg, true
+	case "assistant":
+		content := msg.Content
+		if len(msg.ToolCalls) > 0 {
+			calls := make([]string, 0, len(msg.ToolCalls))
+			for _, tc := range msg.ToolCalls {
+				name, args := tc.Name, ""
+				if tc.Function != nil {
+					if tc.Function.Name != "" {
+						name = tc.Function.Name
+					}
+					args = tc.Function.Arguments
+				}
+				if name == "" {
+					continue
+				}
+				calls = append(calls, name+"("+clip(args, maxToolArgRunes)+")")
+			}
+			if len(calls) > 0 {
+				if strings.TrimSpace(content) != "" {
+					content += "\n"
+				}
+				content += "[tool calls: " + strings.Join(calls, "; ") + "]"
+			}
+		}
+		if strings.TrimSpace(content) == "" {
+			return msg, false
+		}
+		msg.Content = content
+		return msg, true
+	case "tool":
+		if strings.TrimSpace(msg.Content) == "" {
+			return msg, false
+		}
+		msg.Content = "[tool result] " + clip(msg.Content, maxToolResultRunes)
+		return msg, true
+	}
+	return msg, false
+}

#!/usr/bin/env python3
"""hdash - publish a local dashboard/web app to the owner's Tailscale network (phone + PC), safely.

  hdash start <name> <folder>            serve a static folder (index.html ...)      -> prints URL
  hdash start <name> --cmd "<command>"   run your own server; use {port} in the command (cwd = --dir or workspace/dashboards/<name>)
  hdash list                             running dashboards with URLs
  hdash url [name]                       URLs again
  hdash stop <name>                      stop + unpublish
  hdash restart <name>
  hdash restore                          (used on boot) bring registered dashboards back

Only ports 8100-8199 are ever published, nothing else on the tailnet is touched, no system config is changed.
"""
import json, os, signal, socket, subprocess, sys, time

HOME = os.path.expanduser("~")
WORKSPACE = os.environ.get("HERMES_WORKSPACE") or os.path.join(HOME, ".picoclaw", "workspace")
ROOT = os.path.join(WORKSPACE, "dashboards")
REG = os.path.join(ROOT, "registry.json")
LOGDIR = os.path.join(ROOT, ".logs")
LO, HI = int(os.environ.get("DASH_PORT_MIN", "8100")), int(os.environ.get("DASH_PORT_MAX", "8199"))
TS_SOCK = os.environ.get("TS_SOCKET", "/tmp/tailscale/tailscaled.sock")
NO_TS = os.environ.get("DASH_NO_TAILSCALE") == "1"          # tests / no tailscale
HOSTNAME = os.environ.get("TAILSCALE_HOSTNAME", "hermes")


def die(msg, code=1):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def load():
    try:
        with open(REG, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def save(reg):
    os.makedirs(ROOT, exist_ok=True)
    tmp = REG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(reg, f, indent=2, ensure_ascii=False)
    os.replace(tmp, REG)


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def port_open(port, timeout=0.5):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout):
            return True
    except OSError:
        return False


def ts(*args, timeout=30):
    return subprocess.run(["tailscale", f"--socket={TS_SOCK}", *args], capture_output=True, text=True, timeout=timeout)


def ts_ip():
    if NO_TS:
        return "127.0.0.1"
    try:
        r = ts("ip", "-4", timeout=10)
        return (r.stdout.split() or [""])[0]
    except Exception:
        return ""


def urls(port):
    out = []
    if NO_TS:
        return [f"http://127.0.0.1:{port}/"]
    ip = ts_ip()
    out.append(f"http://{HOSTNAME}:{port}/")
    if ip:
        out.append(f"http://{ip}:{port}/")
    return out


def pick_port(reg, wanted=None):
    used = {int(v["port"]) for v in reg.values()}
    if wanted:
        if not (LO <= wanted <= HI):
            die(f"port must be in {LO}-{HI}")
        if wanted in used or port_open(wanted):
            die(f"port {wanted} is already in use")
        return wanted
    for p in range(LO, HI + 1):
        if p not in used and not port_open(p):
            return p
    die("no free port in range")


def publish(port):
    if NO_TS:
        return True, ""
    r = ts("serve", "--bg", f"--tcp={port}", f"tcp://127.0.0.1:{port}")
    return r.returncode == 0, (r.stderr or r.stdout).strip()


def unpublish(port):
    if NO_TS:
        return
    try:
        ts("serve", f"--tcp={port}", "off")
    except Exception:
        pass


def spawn(name, entry):
    os.makedirs(LOGDIR, exist_ok=True)
    port = entry["port"]
    cwd = entry["dir"]
    os.makedirs(cwd, exist_ok=True)
    if entry["kind"] == "static":
        cmd = [sys.executable, "-m", "http.server", str(port), "--bind", "127.0.0.1", "--directory", cwd]
    else:
        cmd = ["bash", "-lc", entry["cmd"].replace("{port}", str(port))]
    log = open(os.path.join(LOGDIR, f"{name}.log"), "ab")
    env = dict(os.environ, PORT=str(port), DASH_PORT=str(port))
    p = subprocess.Popen(cmd, cwd=cwd, stdout=log, stderr=log, stdin=subprocess.DEVNULL, env=env, start_new_session=True)
    entry["pid"] = p.pid
    for _ in range(40):                      # wait up to ~10 s for it to listen
        if p.poll() is not None:
            break
        if port_open(port):
            return True
        time.sleep(0.25)
    return port_open(port)


def log_tail(name, n=15):
    try:
        with open(os.path.join(LOGDIR, f"{name}.log"), encoding="utf-8", errors="replace") as f:
            return "".join(f.readlines()[-n:])
    except Exception:
        return ""


def stop_entry(entry):
    pid = entry.get("pid")
    if pid and alive(pid):
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        for _ in range(20):
            if not alive(pid):
                break
            time.sleep(0.1)
    unpublish(entry["port"])


def valid_name(n):
    return n and all(c.isalnum() or c in "-_" for c in n) and len(n) <= 40


def cmd_start(args):
    if len(args) < 2 or not valid_name(args[0]):
        die("usage: hdash start <name> <folder> | hdash start <name> --cmd \"<command>\" [--dir D] [--port N]")
    name, rest = args[0], args[1:]
    reg = load()
    if name in reg:
        stop_entry(reg[name])
        reg.pop(name)
    cmd = port = folder = None
    i = 0
    while i < len(rest):
        if rest[i] == "--cmd" and i + 1 < len(rest):
            cmd = rest[i + 1]; i += 2
        elif rest[i] == "--dir" and i + 1 < len(rest):
            folder = rest[i + 1]; i += 2
        elif rest[i] == "--port" and i + 1 < len(rest):
            port = int(rest[i + 1]); i += 2
        else:
            folder = folder or rest[i]; i += 1
    d = os.path.abspath(os.path.expanduser(folder)) if folder else os.path.join(ROOT, name)
    if cmd is None and not os.path.isdir(d):
        die(f"folder not found: {d}")
    entry = {"kind": "cmd" if cmd else "static", "cmd": cmd, "dir": d, "port": pick_port(reg, port), "pid": None}
    ok = spawn(name, entry)
    if not ok:
        stop_entry(entry)
        die(f"'{name}' did not start listening on port {entry['port']}.\n--- log ---\n{log_tail(name)}")
    pub_ok, pub_err = publish(entry["port"])
    reg[name] = entry
    save(reg)
    if not pub_ok:
        die(f"'{name}' runs locally on 127.0.0.1:{entry['port']} but Tailscale publish failed: {pub_err}\n"
            "Tailscale may be down (TAILSCALE_AUTHKEY?). Tell the owner; do not change tailscale yourself.")
    print(f"LIVE: {name}")
    for u in urls(entry["port"]):
        print("  " + u)
    print("Open one of these on any device logged in to the owner's Tailscale (phone or PC).")


def cmd_list(_):
    reg = load()
    if not reg:
        print("(no dashboards)")
    for name, e in sorted(reg.items()):
        state = "running" if e.get("pid") and alive(e["pid"]) and port_open(e["port"]) else "STOPPED"
        print(f"{name}  [{state}]  {e['kind']}  port {e['port']}  dir {e['dir']}")
        if state == "running":
            for u in urls(e["port"]):
                print("   " + u)


def cmd_url(args):
    reg = load()
    names = args or sorted(reg)
    for n in names:
        if n not in reg:
            die(f"unknown dashboard: {n}")
        print(n)
        for u in urls(reg[n]["port"]):
            print("  " + u)


def cmd_stop(args):
    if not args:
        die("usage: hdash stop <name>")
    reg = load()
    e = reg.pop(args[0], None)
    if not e:
        die(f"unknown dashboard: {args[0]}")
    stop_entry(e)
    save(reg)
    print(f"stopped {args[0]}")


def cmd_restart(args):
    if not args:
        die("usage: hdash restart <name>")
    reg = load()
    e = reg.get(args[0])
    if not e:
        die(f"unknown dashboard: {args[0]}")
    stop_entry(e)
    if not spawn(args[0], e):
        die(f"restart failed\n{log_tail(args[0])}")
    publish(e["port"])
    save(reg)
    cmd_url([args[0]])


def cmd_restore(_):
    reg = load()
    if not reg:
        return
    if not NO_TS:
        for _i in range(90):                  # wait for tailscale (started in the background at boot)
            try:
                if ts("status", timeout=5).returncode == 0 and ts_ip():
                    break
            except Exception:
                pass
            time.sleep(2)
    for name, e in reg.items():
        if not (e.get("pid") and alive(e["pid"]) and port_open(e["port"])):
            print(f"restoring {name} on port {e['port']}: {'ok' if spawn(name, e) else 'FAILED'}")
        publish(e["port"])
    save(reg)


COMMANDS = {"start": cmd_start, "list": cmd_list, "url": cmd_url, "stop": cmd_stop, "restart": cmd_restart, "restore": cmd_restore}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__)
        sys.exit(0 if len(sys.argv) < 2 else 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])
